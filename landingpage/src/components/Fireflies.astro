<canvas class="fireflies" id="fireflies" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById("fireflies") as HTMLCanvasElement | null;
  const root = document.documentElement;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (canvas && !reduceMotion) {
    const ctx = canvas.getContext("2d")!;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const COUNT = 26;

    // sprite pré-renderizado: ponto quente + halo
    const sprite = document.createElement("canvas");
    sprite.width = sprite.height = 64;
    const sctx = sprite.getContext("2d")!;
    const glow = sctx.createRadialGradient(32, 32, 0, 32, 32, 32);
    glow.addColorStop(0, "rgba(255, 214, 140, 1)");
    glow.addColorStop(0.25, "rgba(255, 190, 100, 0.55)");
    glow.addColorStop(1, "rgba(255, 180, 90, 0)");
    sctx.fillStyle = glow;
    sctx.fillRect(0, 0, 64, 64);

    interface Fly {
      x: number;
      y: number;
      vx: number;
      vy: number;
      size: number;
      phase: number;
      speed: number;
    }

    let flies: Fly[] = [];
    let rafId: number | null = null;
    let t = 0;

    function resize() {
      canvas!.width = window.innerWidth * dpr;
      canvas!.height = window.innerHeight * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function spawn() {
      flies = Array.from({ length: COUNT }, () => ({
        x: Math.random() * window.innerWidth,
        y: Math.random() * window.innerHeight,
        vx: (Math.random() - 0.5) * 0.28,
        vy: (Math.random() - 0.5) * 0.22,
        size: 6 + Math.random() * 14,
        phase: Math.random() * Math.PI * 2,
        speed: 0.4 + Math.random() * 0.8,
      }));
    }

    function frame() {
      t += 0.008;
      const w = window.innerWidth;
      const h = window.innerHeight;
      ctx.clearRect(0, 0, w, h);

      for (const f of flies) {
        f.x += f.vx + Math.sin(t * f.speed + f.phase) * 0.3;
        f.y += f.vy + Math.cos(t * f.speed * 0.8 + f.phase) * 0.24;

        if (f.x < -40) f.x = w + 40;
        if (f.x > w + 40) f.x = -40;
        if (f.y < -40) f.y = h + 40;
        if (f.y > h + 40) f.y = -40;

        const twinkle = 0.25 + 0.75 * (0.5 + 0.5 * Math.sin(t * 2.2 * f.speed + f.phase * 3));
        ctx.globalAlpha = twinkle * 0.85;
        const s = f.size * (0.7 + 0.3 * twinkle);
        ctx.drawImage(sprite, f.x - s / 2, f.y - s / 2, s, s);
      }

      rafId = requestAnimationFrame(frame);
    }

    function sync() {
      const off = root.dataset.light === "off";
      if (off && rafId === null) {
        resize();
        rafId = requestAnimationFrame(frame);
      } else if (!off && rafId !== null) {
        cancelAnimationFrame(rafId);
        rafId = null;
        ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
      }
    }

    resize();
    spawn();
    sync();

    new MutationObserver(sync).observe(root, {
      attributes: true,
      attributeFilter: ["data-light"],
    });
    window.addEventListener("resize", resize, { passive: true });
  }
</script>
