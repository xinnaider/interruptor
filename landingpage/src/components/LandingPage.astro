---
import Base from "../layouts/Base.astro";
import HeroSwitch from "./HeroSwitch.astro";
import Fireflies from "./Fireflies.astro";
import { GITHUB_URL, INSTALL_CMD } from "../consts";
import { copy, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = copy[lang];
const otherLang: Lang = lang === "pt" ? "en" : "pt";
---

<Base title={c.metaTitle} description={c.metaDescription} lang={c.htmlLang} skipLink={c.skipLink}>
  <header class="site-header">
    <nav class="nav-pill" aria-label="Principal">
      <a class="brand" href={lang === "pt" ? "/" : "/en/"}>
        <img src="/favicon.svg" alt="" width="18" height="18" />
        Interruptor
      </a>
      <div class="nav-links">
        <a href="#faq">{c.faq.eyebrow}</a>
        <a href={GITHUB_URL} rel="noopener noreferrer">GitHub</a>
        <span class="lang-divider" aria-hidden="true"></span>
        <a
          href="/"
          class:list={["lang-link", { active: lang === "pt" }]}
          aria-current={lang === "pt" ? "page" : undefined}
          aria-label={c.langLabel}>PT</a
        >
        <a
          href="/en/"
          class:list={["lang-link", { active: lang === "en" }]}
          aria-current={lang === "en" ? "page" : undefined}
          aria-label={c.langLabel}>EN</a
        >
      </div>
    </nav>
  </header>

  <main id="conteudo">
    <section class="hero container" data-mouse-parallax data-parallax-section>
      <div class="ambient-wrap" data-parallax-layer data-parallax-speed="0.22" aria-hidden="true">
        <div class="ambient" data-mouse-depth="0.09"></div>
      </div>

      <div class="hero-copy">
        <p class="platform-badge" data-reveal="fade-up">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.63 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z" />
          </svg>
          {c.hero.badge}
        </p>
        <h1 class="gradient-text" data-motion-text="lines">
          <span class="motion-line-mask"
            ><span class="motion-line">{c.hero.line1}</span></span
          >
          <span class="motion-line-mask"
            ><span class="motion-line">{c.hero.line2}</span></span
          >
        </h1>
        <p class="sub" data-reveal="fade-up" data-reveal-delay="0.2">
          {c.hero.sub}
        </p>
        <div class="install-block" data-reveal="fade-up" data-reveal-delay="0.28">
          <pre class="install-cmd"><code id="install-cmd">{INSTALL_CMD}</code></pre>
          <button type="button" class="btn btn-primary install-copy" data-copy-install data-label={c.install.copy} data-copied={c.install.copied}>
            <i class="ph ph-copy" aria-hidden="true"></i>
            <span>{c.install.copy}</span>
          </button>
        </div>
        <p class="hero-github" data-reveal="fade-up" data-reveal-delay="0.34">
          <a href={GITHUB_URL} rel="noopener noreferrer">{c.hero.github}</a>
        </p>
        <div class="proof" data-reveal="fade-up" data-reveal-delay="0.4">
          <span><i class="ph ph-seal-check" aria-hidden="true"></i> {c.hero.proof1}</span>
          <span>{c.hero.proof2}</span>
        </div>
      </div>

      <HeroSwitch labelOn={c.switch.on} labelOff={c.switch.off} />
    </section>

    <section class="section container" aria-labelledby="recursos-titulo">
      <div class="section-head">
        <p class="eyebrow" data-reveal="fade-up">{c.features.eyebrow}</p>
        <h2 id="recursos-titulo" data-motion-text="words">{c.features.title}</h2>
      </div>
      <ul class="features" data-reveal-group>
        {
          c.features.items.map((f) => (
            <li class="feature" data-reveal-item>
              <div class="feature-icon" aria-hidden="true">
                <i class={`ph ${f.icon}`} style="font-size: 18px"></i>
              </div>
              <div>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section container" id="faq" aria-labelledby="faq-titulo">
      <div class="section-head">
        <p class="eyebrow" data-reveal="fade-up">{c.faq.eyebrow}</p>
        <h2 id="faq-titulo" data-motion-text="words">{c.faq.title}</h2>
      </div>
      <div class="faq-list" data-reveal-group>
        {
          c.faq.items.map((f) => (
            <details data-reveal-item>
              <summary>
                {f.q}
                <i class="ph ph-caret-down chev" aria-hidden="true" />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="final container" aria-labelledby="final-titulo">
      <h2 id="final-titulo" class="gradient-text" data-motion-text="words">{c.final.title}</h2>
      <p data-reveal="fade-up">{c.final.sub}</p>
      <p class="final-github" data-reveal="fade-up" data-reveal-delay="0.1">
        <a href={GITHUB_URL} rel="noopener noreferrer">{c.hero.github}</a>
      </p>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-row">
      <span>{c.footer.note}</span>
      <div class="footer-links">
        <a href={GITHUB_URL} rel="noopener noreferrer">GitHub</a>
        <a href="#conteudo">{c.footer.top}</a>
      </div>
    </div>
  </footer>

  <Fireflies slot="overlays" />

  <script>
    import Lenis from "lenis";
    import "lenis/dist/lenis.css";
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);
    gsap.defaults({ ease: "power2.out", duration: 0.28 });

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

    if (!reduceMotion) {
      const lenis = new Lenis({
        lerp: 0.1,
        smoothWheel: true,
        wheelMultiplier: 0.85,
        anchors: true,
      });
      lenis.on("scroll", ScrollTrigger.update);
      gsap.ticker.add((time) => lenis.raf(time * 1000));
      gsap.ticker.lagSmoothing(0);
      window.addEventListener("load", () => ScrollTrigger.refresh());
    }

    function splitWords(element: Element) {
      const text = element.textContent || "";
      const parts = text.split(/(\s+)/);
      element.textContent = "";
      element.setAttribute("aria-label", text.trim());
      parts.forEach((part) => {
        if (!part.trim()) {
          element.appendChild(document.createTextNode(part));
          return;
        }
        const mask = document.createElement("span");
        const word = document.createElement("span");
        mask.className = "motion-word-mask";
        mask.setAttribute("aria-hidden", "true");
        word.className = "motion-word";
        word.textContent = part;
        mask.appendChild(word);
        element.appendChild(mask);
      });
    }

    function initTextReveals() {
      if (reduceMotion) {
        gsap.set("[data-motion-text]", { autoAlpha: 1, clearProps: "all" });
        return;
      }

      gsap.utils.toArray("[data-motion-text='words']").forEach((el) => {
        const element = el as HTMLElement;
        splitWords(element);
        gsap.set(element, { autoAlpha: 1 });
        gsap.fromTo(
          element.querySelectorAll(".motion-word"),
          { yPercent: 100, autoAlpha: 0 },
          {
            yPercent: 0,
            autoAlpha: 1,
            duration: 0.45,
            stagger: 0.04,
            scrollTrigger: { trigger: element, start: "top 85%", once: true },
          }
        );
      });

      gsap.utils.toArray("[data-motion-text='lines']").forEach((el) => {
        const element = el as HTMLElement;
        const lines = element.querySelectorAll(".motion-line");
        gsap.set(element, { autoAlpha: 1 });
        gsap.fromTo(
          lines,
          { yPercent: 100, autoAlpha: 0 },
          {
            yPercent: 0,
            autoAlpha: 1,
            duration: 0.5,
            stagger: 0.08,
            delay: 0.08,
          }
        );
      });
    }

    function initScrollReveals() {
      if (reduceMotion) {
        gsap.set("[data-reveal], [data-reveal-item]", { autoAlpha: 1, clearProps: "all" });
        return;
      }

      gsap.utils.toArray("[data-reveal-group]").forEach((group) => {
        const items = (group as HTMLElement).querySelectorAll("[data-reveal-item]");
        gsap.fromTo(
          items,
          { y: 16, autoAlpha: 0, scale: 0.96 },
          {
            y: 0,
            autoAlpha: 1,
            scale: 1,
            duration: 0.4,
            stagger: 0.06,
            scrollTrigger: { trigger: group as HTMLElement, start: "top 85%", once: true },
          }
        );
      });

      gsap.utils.toArray("[data-reveal]:not([data-reveal-item])").forEach((el) => {
        const element = el as HTMLElement;
        gsap.fromTo(
          element,
          { y: 12, autoAlpha: 0, scale: 0.96 },
          {
            y: 0,
            autoAlpha: 1,
            scale: 1,
            duration: 0.35,
            delay: Number(element.dataset.revealDelay || 0),
            scrollTrigger: { trigger: element, start: "top 90%", once: true },
          }
        );
      });
    }

    function initHeroIntro() {
      const switchWrap = document.querySelector(".hero-switch");
      const ambient = document.querySelector(".ambient");
      if (reduceMotion) {
        gsap.set([switchWrap, ambient], { autoAlpha: 1, clearProps: "all" });
        return;
      }
      gsap
        .timeline({ delay: 0.05 })
        .fromTo(ambient, { autoAlpha: 0, scale: 0.96 }, { autoAlpha: 1, scale: 1, duration: 0.6 }, 0)
        .fromTo(
          switchWrap,
          { autoAlpha: 0, y: 12, scale: 0.96 },
          { autoAlpha: 1, y: 0, scale: 1, duration: 0.5 },
          0.12
        );
    }

    function initMouseParallax() {
      if (reduceMotion || !finePointer) return;
      gsap.utils.toArray("[data-mouse-parallax]").forEach((sec) => {
        const section = sec as HTMLElement;
        const layers = section.querySelectorAll("[data-mouse-depth]");
        const setters = Array.from(layers).map((layer) => ({
          depth: Number((layer as HTMLElement).dataset.mouseDepth || 0.04),
          xTo: gsap.quickTo(layer, "x", { duration: 0.6, ease: "power2.out" }),
          yTo: gsap.quickTo(layer, "y", { duration: 0.6, ease: "power2.out" }),
        }));
        section.addEventListener("pointermove", (event) => {
          const rect = section.getBoundingClientRect();
          const x = event.clientX - rect.left - rect.width / 2;
          const y = event.clientY - rect.top - rect.height / 2;
          setters.forEach(({ depth, xTo, yTo }) => {
            xTo(x * depth);
            yTo(y * depth);
          });
        });
        section.addEventListener("pointerleave", () => {
          setters.forEach(({ xTo, yTo }) => {
            xTo(0);
            yTo(0);
          });
        });
      });
    }

    function initParallax() {
      if (reduceMotion) return;
      gsap.utils.toArray("[data-parallax-layer]").forEach((layer) => {
        const speed = Number((layer as HTMLElement).dataset.parallaxSpeed || 0.18);
        const section = layer.closest("[data-parallax-section]") || layer;
        gsap.to(layer, {
          y: () => window.innerHeight * speed * -1,
          ease: "none",
          scrollTrigger: {
            trigger: section as Element,
            start: "top bottom",
            end: "bottom top",
            scrub: 1,
            invalidateOnRefresh: true,
          },
        });
      });
    }

    initTextReveals();
    initScrollReveals();
    initHeroIntro();
    initMouseParallax();
    initParallax();
    ScrollTrigger.refresh();

    document.querySelectorAll("[data-copy-install]").forEach((btn) => {
      const button = btn as HTMLButtonElement;
      const cmd = document.getElementById("install-cmd")?.textContent || "";
      const label = button.dataset.label || "";
      const copied = button.dataset.copied || "";
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(cmd);
          const span = button.querySelector("span");
          if (span) span.textContent = copied;
          setTimeout(() => { if (span) span.textContent = label; }, 2000);
        } catch {}
      });
    });
  </script>
</Base>
